# Copie para ".env" (mesma pasta do programa) e edite o que precisar. Reinicie o programa depois.
# A impressora, o backup e os usuários são configurados dentro do sistema (tela Configurações).

# Porta do sistema (endereço: http://localhost:3000)
PORTA=3000

# Chave que o n8n usa para criar pedidos (header x-api-key). Enquanto estiver vazia, a rota /n8n fica bloqueada.
API_KEY=

# Opcional: ativa o botão "Entrar com Google". Só entram e-mails já cadastrados em Configurações > Usuários.
GOOGLE_CLIENT_ID=

# Opcional: segredo do login (mínimo 32 caracteres). Se vazio, o sistema cria um sozinho em data\jwt.key.
JWT_SECRET=

# Nota fiscal (NFC-e): deixe false até integrar um provedor.
FISCAL_ATIVO=false
