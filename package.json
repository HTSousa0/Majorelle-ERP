{
  "name": "pizzaria-erp",
  "version": "0.3.0",
  "description": "Majorelle ERP — sistema de gestão para pizzaria (Windows)",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
